@{
    ViewData["Title"] = "Giới thiệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="home-container">
    <div class="dec-body"></div>

    <div class="header-container">
        <div class="nav-bar">
            <div class="d-flex gap-5 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="nav-link-item">Trang chủ</a>
                <a asp-action="GioiThieu" class="nav-link-item active">Giới thiệu</a>
                <a asp-action="LienHe" class="nav-link-item">Liên hệ</a>
                <a asp-action="HuongDan" class="nav-link-item">Hướng dẫn</a>
                <a href="/Booking/Booking" class="nav-link-item">Đặt lịch</a>
            </div>
        </div>
    </div>

    <div class="wrapper-container">
        <div class="container content-box bg-white p-4 rounded shadow">
            <h2 class="text-primary mb-4">Giới thiệu hệ thống đặt lịch khám</h2>
            <p>Hệ thống đặt lịch khám bệnh giúp người dân dễ dàng tiếp cận dịch vụ y tế chất lượng.</p>
            <ul>
                <li>💡 Đặt lịch trước, không cần chờ đợi</li>
                <li>💡 Chủ động chọn thời gian và chuyên khoa</li>
                <li>💡 Quản lý lịch sử khám bệnh và tái khám</li>
                <li>💡 Nhắc lịch tự động qua SMS & Email</li>
            </ul>
            <img src="https://img.freepik.com/premium-vector/hospital-illustration-concept_701961-52.jpg"
                 class="img-fluid rounded mt-4 shadow-sm" style="max-height: 300px;" />
        </div>
    </div>
</div>
