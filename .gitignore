## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Release]/
x64/
x86/
bbin/
bin/
obj/

# Visual Studio 2015/2017/2019/2022 cache and settings
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet Packages
packages/
*.nuget.props
*.nuget.targets

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db